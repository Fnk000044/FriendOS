{
  "name": "FriendOS",
  "private": true,
  "version": "0.0.6",
  "author": "FriendOS User",
  "description": "全功能个人管理系统",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "pack": "vite build && node scripts/package-manual.js",
    "dist": "vite build && electron-builder --win --config electron-builder.json",
    "installer": "node scripts/build-installer.cjs",
    "icon": "node scripts/generate-ico.cjs",
    "eval:sentiment": "node scripts/eval-sentiment.cjs",
    "eval:risk": "node scripts/eval-risk.cjs",
    "eval:external": "node scripts/external_validation.cjs",
    "eval:onnx-external": "node scripts/eval-onnx-external.cjs",
    "eval:onnx-external2": "node scripts/eval-onnx-external-v2.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:smoke": "echo 见 docs/offline_smoke_test.md（打包版离线冒烟清单）"
  },
  "build": {
    "appId": "com.friendos.app",
    "productName": "FriendOS",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/custom-icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^0.441.0",
    "onnxruntime-node": "^1.26.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.4.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "recharts": "^2.12.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.10"
  }
}
